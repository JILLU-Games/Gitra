# Local development values used by `wrangler types`.
# Copy this file to `.dev.vars` and replace placeholders as needed.

# Repo Durable Object idle cleanup threshold in minutes.
REPO_DO_IDLE_MINUTES=30

# Logging level: debug|info|warn|error.
LOG_LEVEL=debug

# Local goc browser session cookie sealing secret. Generate a real value with
# `openssl rand -hex 32`, then set production with
# `wrangler secret put SESSION_SECRET`; never commit a real production value.
SESSION_SECRET=local-goc-session-secret-change-me

# Authentication runtime mode: development | production.
# - Local `npm run dev` runs in development/demo mode by default.
# - Production builds (`npm run build` / `npm run deploy`) automatically
#   compile in production mode (`import.meta.env.PROD === true`) with demo
#   sign-in and mock repository seeding disabled.
AUTH_MODE=development

# Optional admin login credentials. Leave ADMIN_PASSWORD unset in local dev
# to enable Demo Mode (default `admin` / `admin123` and `alex-dev` / `devuser123`).
# In production, set ADMIN_PASSWORD with `wrangler secret put ADMIN_PASSWORD`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
