{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Default configuration: Cloudflare Workers Free Plan friendly.
  // - Uses SQLite-backed Durable Objects, D1, KV, R2, and Queues (all available on Free tier).
  // - Omits Paid-only `limits.cpu_ms` so `npm run deploy` succeeds on Free accounts.
  // - For Workers Paid ($5/mo+) with 5-minute CPU limits and automatic compaction,
  //   deploy with `npm run deploy:paid` (uses `wrangler.paid.jsonc`).
  "name": "git-on-cloudflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": true,
  // Optional custom domain routes (uncomment and replace with a zone in your Cloudflare account):
  // "routes": [
  //   {
  //     "pattern": "git.yourdomain.com",
  //     "custom_domain": true
  //   }
  // ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPO_DO",
        "class_name": "RepoDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RepoDurableObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AuthDurableObject"
      ]
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "AuthDurableObject"
      ]
    }
  ],
  // Clean local-dev & template bindings (no production IDs or domains committed).
  // Real Cloudflare IDs, bucket/queue names, and optional APP_DOMAIN routes are
  // resolved dynamically at deploy time via `npm run cf:auto-deploy`.
  "kv_namespaces": [
    {
      "binding": "ROUTES",
      "id": "local-routes-kv"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "local-git-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPO_BUCKET",
      "bucket_name": "local-git-repos"
    }
  ],
  // Cloudflare Queues is included on Free tier (10,000 ops/day).
  // Set USE_QUEUES=false (or --no-queues) during `npm run cf:auto-deploy` to
  // omit Queues and use automatic inline execution for repo delete & route sync.
  "queues": {
    "producers": [
      {
        "binding": "REPO_TASKS_QUEUE",
        "queue": "local-repo-maint"
      }
    ],
    "consumers": [
      {
        "queue": "local-repo-maint",
        "max_batch_size": 1,
        "max_batch_timeout": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
    "html_handling": "none"
  },
  // Environment variables (text/JSON)
  "vars": {
    // Deployment plan tier: "free" (default) | "paid"
    "CLOUDFLARE_TIER": "free",
    // Repo DO idle cleanup threshold (minutes)
    "REPO_DO_IDLE_MINUTES": "30",
    // Logging level: debug|info|warn|error
    "LOG_LEVEL": "info"
  }
}
